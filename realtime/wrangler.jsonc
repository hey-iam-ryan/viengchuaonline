{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "viengchua-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "HALL", "class_name": "Hall" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hall", "Lobby"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://hey-iam-ryan.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"
  },
  "observability": { "enabled": true }
}
